# Build outputs (make -> ./build)
/build/
*.o

# A Python environment, if one is made here. Training itself lives in reckless-technology/nnue-training
/.venv/

# Training artifacts: self-play datasets and net checkpoints (large / regenerable)
/data/
/nets/
__pycache__/
*.pyc

# NNUE nets come from the shared trainer (nnue-training); commit a chosen release net with `git add -f`
*.nnue

# fastchess writes this into the working directory when running matches
/config.json
/zenith-ob
/zenith-kb
/zenith-*

# Generated API documentation
doc/html/

# Opening books are downloaded on demand (make get-book), never committed - but Zenith's own, which are
/books/*
!/books/README.md
!/books/zenith-book-r*.bin
